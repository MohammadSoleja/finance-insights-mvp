# Environment Variables for Finance Insights MVP
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to git!

# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (if using PostgreSQL instead of SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# AI Provider Configuration
# Choose one: "openai", "gemini", "huggingface", "groq"
AI_PROVIDER=openai

# OpenAI API (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1500
OPENAI_TEMPERATURE=0.7

# Google Gemini API (https://ai.google.dev/)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash-latest

# Hugging Face API (https://huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY=your-huggingface-api-key-here
HUGGINGFACE_MODEL=google/flan-t5-large

# Groq API (https://console.groq.com/)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant

# Email Configuration (for invoice sending, etc.)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# Playbook Features
PLAYBOOK_ENABLE_CONVERSATIONS=True
PLAYBOOK_ENABLE_SIMULATIONS=True

